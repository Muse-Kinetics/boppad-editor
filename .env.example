# Copy to `.env` (gitignored) and `set -a; source .env; set +a` before deploying.
# These configure the web-editor deploy target for apps/web/scripts/deploy-build.js.
# The deploy target is read from the environment so no internal host path lives
# in the (public-track) source tree.

# Deploy target for the live BopPad web editor. Real values stay in `.env`.
BP_WEB_SSH_SERVER=user@host
BP_WEB_SSH_LOCATION=/absolute/path/to/products/boppad/editor

# Optional staging/dev target (used by `deploy:web:dev` / `--target dev`).
# BP_WEB_DEV_SSH_SERVER=user@host
# BP_WEB_DEV_SSH_LOCATION=/absolute/path/to/products/boppad/editor-dev

# Optional: remote group for the post-upload chgrp (defaults to www-data).
# BP_WEB_REMOTE_GROUP=www-data

# The shared KB_WEB_* / KB_* vars are honored as fallbacks if the BP_WEB_* ones
# are unset, so a single sourced env can serve both editors.

# --- Desktop signing/notarization (see apps/desktop/.env.example) ---
# APPLE_KEYCHAIN_PROFILE=your-notarytool-profile-name
