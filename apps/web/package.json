{
  "name": "boppad-editor",
  "productName": "BopPad Editor",
  "version": "1.3.0",
  "private": true,
  "description": "Editor for Keith McMillen Instruments BopPad",
  "repository": "git+ssh://git@github.com/Muse-Kinetics/boppad-editor.git",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --config webpack.production.config.js",
    "start": "webpack serve --config webpack.config.js",
    "deploy": "node ./scripts/deploy-build.js",
    "deploy:dev": "node ./scripts/deploy-build.js --target dev",
    "build:deploy": "npm run build && npm run deploy --",
    "build:deploy:dev": "npm run build && npm run deploy:dev --",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": {
    "name": "Andrej Hronco",
    "email": "andrej@keithmcmillen.com",
    "url": "https://musekinetics.com"
  },
  "license": "MPL-2.0",
  "devDependencies": {
    "@babel/core": "^7.14.3",
    "@babel/preset-env": "^7.14.4",
    "babel-loader": "^8.2.2",
    "copy-webpack-plugin": "^9.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^5.2.6",
    "html-webpack-plugin": "^5.3.1",
    "mini-css-extract-plugin": "^1.6.0",
    "sass": "^1.34.1",
    "sass-loader": "^12.0.0",
    "style-loader": "^2.0.0",
    "svg-inline-loader": "^0.8.2",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.38.1",
    "webpack-cli": "^4.7.0",
    "webpack-dev-server": "^4.15.2"
  },
  "dependencies": {
    "base64-font-loader": "0.0.4",
    "bootstrap-sass": "^3.4.1",
    "boppad-js-api": "*",
    "eve": "^0.5.4",
    "is-electron": "^2.2.0",
    "jquery": "^3.6.0",
    "lodash": "^4.17.21",
    "promise-conditional": "^1.2.0",
    "semver": "^7.3.5",
    "snapsvg-cjs": "0.0.4",
    "tippy.js": "^6.3.1",
    "vanilla-modal": "^1.6.5",
    "webfontloader": "^1.6.28"
  }
}
